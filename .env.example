# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:9877
NEXT_PUBLIC_API_KEY=

# Backend auth (disabled by default for local development)
AGRIPULSE_API_KEY_ENABLED=0
AGRIPULSE_API_KEY=agripulse-dev-key

# Backend data source
# local_csv: always use bundled CSV data
# data_gov: try data.gov.in and fallback to local CSV on failure
AGRIPULSE_PRICE_SOURCE=local_csv
AGRIPULSE_DATA_GOV_API_KEY=
AGRIPULSE_DATA_GOV_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24
AGRIPULSE_DATA_GOV_PAGE_SIZE=200
AGRIPULSE_DATA_GOV_MAX_RECORDS=5000
AGRIPULSE_DATA_GOV_TIMEOUT_SEC=8
AGRIPULSE_DATA_GOV_TOTAL_TIMEOUT_SEC=45

# Report storage (SQLite)
AGRIPULSE_REPORTS_DB_PATH=

# CORS
AGRIPULSE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AGRIPULSE_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
